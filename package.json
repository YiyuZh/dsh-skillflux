{
  "name": "dsh-skillflux",
  "version": "0.2.0",
  "description": "Dynamic skill runtime manager for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/embedding-smoke.mjs",
    "scripts/discovery-smoke.mjs",
    "scripts/cache-governance-smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "eval": "vitest run tests/eval.spec.ts tests/embedding-eval.spec.ts tests/catalog-budget-eval.spec.ts tests/remote-quality-eval.spec.ts tests/remote-governance-eval.spec.ts tests/remote-cache-eval.spec.ts tests/cache-governance-eval.spec.ts tests/remote-fallback-eval.spec.ts --reporter=verbose",
    "test:runtime-live": "pnpm build && node scripts/runtime-smoke.mjs",
    "test:discovery-live": "pnpm build && node scripts/discovery-smoke.mjs",
    "test:embedding-live": "pnpm build && node scripts/embedding-smoke.mjs",
    "test:cache-governance-live": "pnpm build && node scripts/cache-governance-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --dry-run"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent-skills",
    "skill-runtime",
    "cordis"
  ],
  "author": "YiyuZh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiyuZh/dsh-skillflux.git"
  },
  "bugs": {
    "url": "https://github.com/YiyuZh/dsh-skillflux/issues"
  },
  "homepage": "https://github.com/YiyuZh/dsh-skillflux#readme",
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "proper-lockfile": "4.1.2",
    "skills": "1.5.23",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^4.0.0",
    "oxlint": "^1.12.0",
    "tsdown": "0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
