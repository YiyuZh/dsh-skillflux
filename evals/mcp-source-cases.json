  {
    "id": "mcp-minimal-valid",
    "name": "minimal single-file skill",
    "description": "A SKILL.md-only entry with a valid digest and size is accepted",
    "entry": {
      "uri": "skill://git-workflow/SKILL.md",
      "frontmatter": { "name": "git-workflow", "description": "Follow team git conventions" },
      "resources": [
        {
          "uri": "skill://git-workflow/SKILL.md",
          "digest": "sha256:b95a384300adeea2d902f7d19cd7c04b378ef58e09759107b9c7db4dcacbaa25",
          "size": 190
        }
      ]
    },
    "expect": "accept"
  },
  {
    "id": "mcp-nested-with-files",
    "name": "nested path with supporting files",
    "description": "A prefixed skill path with supporting files is accepted",
