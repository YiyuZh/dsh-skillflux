      "uri": "skill://reports/daily/SKILL.md",
      "frontmatter": { "name": "daily", "description": "Assemble today's report" },
      "resources": "dynamic"
    },
    "expect": "reject"
  },
  {
    "id": "mcp-final-segment-mismatch",
