{
  "version": 1,
  "description": "Deterministic routing benchmark for the dsh-skillflux MVP.",
  "defaults": {
    "limit": 3,
    "minScore": 8
  },
  "candidates": [
    {
      "key": "pdf-registry",
      "origin": "registry",
      "name": "pdf-reader",
      "description": "Read PDF files and extract text",
      "whenToUse": "Open analyze and summarize PDF documents",
      "source": "project-skills"
    },
    {
      "key": "pdf-cache",
      "origin": "cache",
      "name": "pdf-reader",
      "description": "Read PDF files and extract text",
      "whenToUse": "Open analyze and summarize PDF documents",
      "source": "community/pdf-reader",
      "installs": 900
    },
    {
      "key": "document-parser",
