      "source": "community/table-extractor",
      "installs": 300
    },
    {
      "key": "metadata-extractor",
      "origin": "cache",
      "name": "metadata-extractor",
      "description": "Document extraction utility",
      "whenToUse": "Extract metadata from PDF documents",
      "source": "community/metadata-extractor",
      "installs": 300
    },
    {
      "key": "popular-log-tool",
      "origin": "cache",
