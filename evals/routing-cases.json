    },
    {
      "key": "chinese-document-reader",
      "origin": "registry",
      "name": "chinese-document-reader",
      "description": "读取并总结中文文档",
      "whenToUse": "分析中文 PDF 报告与合同",
      "source": "project-skills"
    },
    {
      "key": "deploy-helper",
      "origin": "cache",
      "name": "deploy-helper",
      "description": "Deploy web applications to cloud platforms",
      "whenToUse": "Release production builds and configure hosting",
      "source": "community/deploy-helper",
      "installs": 600
    },
    {
      "key": "word-counter",
      "origin": "cache",
      "name": "word-counter",
      "description": "Count words lines and characters in text",
      "whenToUse": "Text statistics and word count",
      "source": "community/word-counter",
      "installs": 400
    },
    {
      "key": "go-helper",
      "origin": "cache",
      "name": "go",
      "description": "Compile Go programs",
      "source": "community/go",
      "installs": 500
