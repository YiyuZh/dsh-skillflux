    {
      "key": "remote-json-tool",
      "origin": "remote",
      "name": "json-tool",
      "description": "Format JSON data",
      "source": "remote/json-tool",
      "installs": 2000
    },
    {
      "key": "alpha-log-tool",
      "origin": "cache",
      "name": "alpha-tool",
      "description": "Inspect service logs",
      "source": "zeta/repository",
      "installs": 100
